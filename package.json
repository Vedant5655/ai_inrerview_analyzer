{
  "name": "ai-interview-analyzer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names backend,frontend --prefix-colors blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload",
    "dev:frontend": "npm --prefix frontend run dev -- --strictPort"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
